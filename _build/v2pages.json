 clamp(120px,16vh,200px)}\n.next a{position:relative;display:block;aspect-ratio:4/3;overflow:hidden;color:#F3F1EA}\n.next a img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform 1.4s cubic-bezier(.2,.7,.2,1)}\n.next a:hover img{transform:scale(1.04)}\n.next a::after{content:\"\";position:absolute;inset:0;background:linear-gradient(to top,rgba(20,18,15,.6),rgba(20,18,15,0) 55%)}\n.next span{position:absolute;left:28px;right:28px;bottom:24px;z-index:1;display:flex;justify-content:space-between;align-items:flex-end;gap:16px}\n.next b{font-size:clamp(28px,3vw,44px);font-weight:300;letter-spacing:-.03em}\n.next small{font-size:14px;opacity:.85}\n@media (max-width:900px){\n  .nums{grid-template-columns:1fr 1fr;gap:32px 16px;padding:0 24px 96px}\n  .steps{grid-template-columns:1fr}\n  .next{grid-template-columns:1fr;padding:0 24px 96px}\n}", "n": "v2-about.html", "b": "<section class=\"ph\">\n    <div class=\"ph-top\">\n      <div><span class=\"label rv\"><b>브랜드</b> — 초월</span><h1 class=\"rv\">초월,<br>넘어서다</h1></div>\n      <div class=\"ph-side rv d2\"><p>초월(超越). 어떠한 한계나 표준을 뛰어넘음.</p><p>막걸리를 초월하다 — 초월의 이름이자 슬로건입니다.</p></div>\n    </div>\n    <div class=\"ph-img mask rv\"><img class=\"px\" data-speed=\"-0.12\" src=\"v2img-a_label.jpg\" alt=\"나무 테이블 위, 공중을 떠다니는 사람들이 그려진 초월 병\" style=\"object-position:72% 50%\"></div>\n  </section>\n  <section class=\"state\">\n    <span class=\"label rv\"><b>재료</b></span>\n    <p class=\"big rv d1\">땅끝 해남에서 자란 쌀과 찹쌀, 국내산 누룩, 그리고 물. <em>감미료를 넣지 않고, 세 번에 걸쳐 빚는 전통 삼양주 방식으로 만듭니다.</em></p>\n  </section>\n  <section class=\"nums\" aria-label=\"숫자로 보는 초월\">\n    <div class=\"num rv\"><b>3<small>번</small></b><span>세 번 빚는 전통 삼양주</span></div>\n    <div class=\"num rv d1\"><b>48<small>일</small></b><span>초월 6.9 발효 · 숙성</span></div>\n    <div class=\"num rv d2\"><b>56<small>일+</small></b><span>DEEP 시리즈 완전 발효</span></div>\n    <div class=\"num rv d3\"><b>0</b><span>감미료</span></div>\n  </section>\n  <section class=\"collage\" aria-label=\"사진\">\n    <figure class=\"ci c1 rv\"><div class=\"mask\"><img class=\"px\" data-speed=\"-0.06\" src=\"v2img-a_brewer.jpg\" alt=\"양조장 바에 앉아 있는 양조사\" loading=\"lazy\"></div><figcaption><span>양조장 바</span><span>01</span></figcaption></figure>\n    <figure class=\"ci c2 rv\"><div class=\"mask\"><img class=\"px\" data-speed=\"-0.1\" src=\"v2img-a_jar.jpg\" alt=\"양조장 선반 위 항아리\" loading=\"lazy\"></div><figcaption><span>오브제</span><span>02</span></figcaption></figure>\n    <figure class=\"ci c3 rv\"><div class=\"mask\"><img class=\"px\" data-speed=\"-0.04\" src=\"v2img-a_space.jpg\" alt=\"고재 기둥이 선 양조장 공간\" loading=\"lazy\"></div><figcaption><span>공간</span><span>03</span></figcaption></figure>\n    <figure class=\"ci c4 rv\"><div class=\"mask\"><img class=\"px\" data-speed=\"-0.08\" src=\"v2img-a_pillar.jpg\" alt=\"나무 벽과 조명\" loading=\"lazy\"></div><figcaption><span>디테일</span><span>04</span></figcaption></figure>\n    <figure class=\"ci c5 rv\"><div class=\"mask\"><img class=\"px\" data-speed=\"-0.05\" src=\"v2img-a_guest.jpg\" alt=\"양조장을 찾은 손님\" loading=\"lazy\"></div><figcaption><span>손님</span><span>05</span></figcaption></figure>\n  </section>\n  <section class=\"sec alt\" aria-labelledby=\"pr\">\n    <div class=\"sec-head\"><div><span class=\"label rv\"><b>만드는 방법</b> — 삼양주</span><h2 id=\"pr\" class=\"rv\">세 번 빚는<br>막걸리</h2></div></div>\n    <div class=\"steps\">\n      <div class=\"step rv\"><span class=\"label\">01</span><b>밑술</b><p>고두밥에 누룩과 물을 더해 첫 술을 빚습니다.</p></div>\n      <div class=\"step rv d1\"><span class=\"label\">02</span><b>덧술</b><p>밑술에 고두밥을 더해 두 번째로 빚습니다.</p></div>\n      <div class=\"step rv d2\"><span class=\"label\">03</span><b>덧술</b><p>한 번 더 덧술해 세 번 빚기를 마칩니다.</p></div>\n      <div class=\"step rv d3\"><span class=\"label\">04</span><b>발효 · 숙성</b><p>초월 6.9는 48일, DEEP 시리즈는 56일 이상.</p></div>\n      <div class=\"step rv d3\"><span class=\"label\">05</span><b>병입</b><p>냉장 상태로 병에 담습니다.</p></div>\n    </div>\n  </section>\n  <div class=\"split\">\n    <div class=\"mask rv\"><img class=\"px\" data-speed=\"-0.06\" src=\"v2img-c_p69.jpg\" alt=\"라벨에 떠 있는 사람들이 그려진 초월 6.9\" loading=\"lazy\"></div>\n    <div class=\"txt rv d1\"><span class=\"label\"><b>라벨</b></span><h3>떠 있는<br>사람들</h3><p>초월 6.9의 라벨에는 공중에 떠 있는 사람들이 그려져 있습니다. 세로로 내려 쓴 ‘초월’ 글자와 함께, 병마다 같은 장면이 담깁니다.</p></div>\n  </div>\n  <section class=\"next\" aria-label=\"다음\">\n    <a class=\"rv\" href=\"v2-products.html\"><img src=\"v2img-deep_duo.jpg\" alt=\"\" loading=\"lazy\"><span><b>제품</b><small>6.9 · DEEP · DEEP Down · SPKL →</small></span></a>\n    <a class=\"rv d1\" href=\"v2-brewery.html\"><img src=\"v2img-c_bar.jpg\" alt=\"\" loading=\"lazy\"><span><b>양조장 · 예약</b><small>테이스팅 세션 →</small></span></a>\n  </section>", "h": "a5d01a59d026e0c3"}, "v2-products.html": {"t": "제품 — 초월", "d": "초월 6.9, DEEP, DEEP Down, SPKL. 해남 쌀과 누룩, 물로 빚은 초월의 라인업.", "c": ".rows{display:flex;flex-direction:column;gap:clamp(120px,18vh,220px);padding:clamp(40px,6vh,80px) var(--gut) clamp(120px,16vh,200px)}\n.row{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:40px var(--gut);align-items:end}\n.row .mask{grid-column:1/8;aspect-ratio:4/5;background:#ddd8cd}\n.row .mask img{width:100%;height:100%;object-fit:cover}\n.row .txt{grid-column:8/13;display:flex;flex-direction:column;gap:18px;padding-bottom:16px}\n.row:nth-child(even) .mask{grid-column:6/13;grid-row:1}\n.row:nth-child(even) .txt{grid-column:1/6;grid-row:1}\n.row h2{font-size:clamp(48px,6.4vw,108px);font-weight:200;line-height:1;letter-spacing:-.045em}\n.row .tag{font-size:clamp(20px,1.8vw,26px);font-weight:300;letter-spacing:-.02em}\n.row p{font-size:16px;line-height:1.8;color:var(--ink-2);max-width:460px}\n.row .meta{display:flex;justify-content:space-between;gap:16px;padding-top:16px;border-top:1px solid var(--line);font-size:14px;color:var(--ink-2)}\n@media (max-width:900px){\n  .rows{gap:96px;padding:24px 24px 96px}\n  .row,.row:nth-child(even){grid-template-columns:1fr;gap:24px}\n  .row .mask,.row .txt,.row:nth-child(even) .mask,.row:nth-child(even) .txt{grid-column:1;grid-row:auto}\n  .row .txt{padding:0}\n}", "n": "v2-products.html", "b": "<section class=\"ph\">\n    <div class=\"ph-top\">\n      <div><span class=\"label rv\"><b>제품</b></span><h1 class=\"rv\">네 가지<br>초월</h1></div>\n      <div class=\"ph-side rv d2\"><p>해남 쌀과 누룩, 물에서 출발한 네 가지 막걸리.</p><p>모든 제품은 냉장 보관(0–10℃)이 필요합니다.</p></div>\n    </div>\n    \n  </section>\n  <section class=\"rows\">\n    <article class=\"row\">\n      <a class=\"mask rv\" href=\"v2-product-69.html\"><img class=\"px\" data-speed=\"-0.05\" src=\"v2img-p69_single.jpg\" alt=\"초월 6.9\" loading=\"lazy\" style=\"object-position:50% 50%\"></a>\n      <div class=\"txt rv d1\"><span class=\"label\">SIGNATURE — 전통 삼양주</span><h2>초월 6.9</h2><p class=\"tag\">가볍지 않은 가벼움</p><p>편하게 즐길 수 있는 접근성과 깊이 있는 질감을 함께. 부드럽게 넘어가면서도 입안에 분명한 존재감을 남기는, 초월의 시그니처입니다.</p>\n        <div class=\"meta\"><span>6.9% · 600 / 750ml</span><span>9,600원부터</span></div><a class=\"link\" href=\"v2-product-69.html\">자세히 보기 <span aria-hidden=\"true\">→</span></a></div>\n    </article>\n    <article class=\"row\">\n      <a class=\"mask rv\" href=\"v2-product-deep.html\"><img class=\"px\" data-speed=\"-0.05\" src=\"v2img-deep_p.jpg\" alt=\"DEEP\" loading=\"lazy\" style=\"object-position:50% 50%\"></a>\n      <div class=\"txt rv d1\"><span class=\"label\">PREMIUM — DEEP SERIES</span><h2>DEEP</h2><p class=\"tag\">“이게 막걸리 맞나요?”</p><p>56일 이상 완전 발효가 끝난 뒤, 원주 중 윗술을 포함시켜 완성합니다. 그래서 소량으로만 생산되며, 일반적인 막걸리보다 훨씬 맑고 깊은 구조를 가지고 있습니다.</p>\n        <div class=\"meta\"><span>18% · 375 / 750ml</span><span>27,000원부터</span></div><a class=\"link\" href=\"v2-product-deep.html\">자세히 보기 <span aria-hidden=\"true\">→</span></a></div>\n    </article>\n    <article class=\"row\">\n      <a class=\"mask rv\" href=\"v2-product-deepdown.html\"><img class=\"px\" data-speed=\"-0.05\" src=\"v2img-down_p.jpg\" alt=\"DEEP Down\" loading=\"lazy\" style=\"object-position:50% 50%\"></a>\n      <div class=\"txt rv d1\"><span class=\"label\">PREMIUM — DEEP SERIES</span><h2>DEEP Down</h2><p class=\"tag\">깊이는 그대로, 도수는 가볍게</p><p>DEEP을 마셔본 분들 중 술이 약한 분들이 하는 말이 있습니다. ‘도수가 좀 부담스럽다.’ 그래서 같은 원주에 가수를 더해 12도로 낮췄습니다.</p>\n        <div class=\"meta\"><span>12% · 375 / 750ml</span><span>19,000원부터</span></div><a class=\"link\" href=\"v2-product-deepdown.html\">자세히 보기 <span aria-hidden=\"true\">→</span></a></div>\n    </article>\n    <article class=\"row\">\n      <a class=\"mask rv\" href=\"v2-product-spkl.html\"><img class=\"px\" data-speed=\"-0.05\" src=\"v2img-c_spkl.jpg\" alt=\"SPKL\" loading=\"lazy\" style=\"object-position:50% 60%\"></a>\n      <div class=\"txt rv d1\"><span class=\"label\">NEW — SPARKLING</span><h2>SPKL</h2><p class=\"tag\">와인 잔에 따르게 되는 술</p><p>찹쌀과 타트체리, 그리고 자연 발효 과정에서 만들어진 은은한 미탄산. 크라운캡을 여는 순간부터 초월 SPKL은 우리가 익숙하게 생각하던 막걸리의 범주를 조금 벗어납니다.</p>\n        <div class=\"meta\"><span>15.6% · 750ml</span><span>28,000원</span></div><a class=\"link\" href=\"v2-product-spkl.html\">자세히 보기 <span aria-hidden=\"true\">→</span></a></div>\n    </article>\n  </section>\n  <section class=\"sec alt\" aria-labelledby=\"cmp\">\n    <div class=\"sec-head\"><div><span class=\"label rv\"><b>비교</b></span><h2 id=\"cmp\" class=\"rv\">나에게 맞는 초월</h2></div></div>\n    <table class=\"cmp rv\"><thead><tr><th scope=\"col\"><span style=\"position:absolute;left:-9999px\">구분</span></th><th scope=\"col\"><a href=\"v2-product-69.html\">초월 6.9</a></th><th scope=\"col\"><a href=\"v2-product-deepdown.html\">DEEP Down</a></th><th scope=\"col\"><a href=\"v2-product-deep.html\">DEEP</a></th><th scope=\"col\"><a href=\"v2-product-spkl.html\">SPKL</a></th></tr></thead><tbody><tr><th scope=\"row\">도수</th><td data-p=\"초월 6.9\">6.9%</td><td data-p=\"DEEP Down\">12%</td><td data-p=\"DEEP\">18%</td><td data-p=\"SPKL\">15.6%</td></tr><tr><th scope=\"row\">원료</th><td data-p=\"초월 6.9\">쌀 · 찹쌀 · 누룩</td><td data-p=\"DEEP Down\">쌀 · 찹쌀 · 누룩</td><td data-p=\"DEEP\">쌀 · 찹쌀 · 누룩</td><td data-p=\"SPKL\">찹쌀 · 누룩 · 타트체리</td></tr><tr><th scope=\"row\">발효</th><td data-p=\"초월 6.9\">48일 · 삼양주</td><td data-p=\"DEEP Down\">56일+ 완전 발효 · 가수</td><td data-p=\"DEEP\">56일+ 완전 발효 · 윗술 포함</td><td data-p=\"SPKL\">자연 발효 · 천연 미탄산</td></tr><tr><th scope=\"row\">바디</th><td data-p=\"초월 6.9\">바디감 있는 담백함</td><td data-p=\"DEEP Down\">풀바디, 묵직하게</td><td data-p=\"DEEP\">6.9보다 가볍게, 밀도 있게</td><td data-p=\"SPKL\">가볍고 산뜻하게</td></tr><tr><th scope=\"row\">마무리</th><td data-p=\"초월 6.9\">부드럽고 균형 잡힌</td><td data-p=\"DEEP Down\">플랫한 드라이</td><td data-p=\"DEEP\">산미 · 은은한 스파이시</td><td data-p=\"SPKL\">타트체리 산미 · 미세한 기포</td></tr><tr><th scope=\"row\">추천 잔</th><td data-p=\"초월 6.9\">전용잔</td><td data-p=\"DEEP Down\">전용잔 · 온더락</td><td data-p=\"DEEP\">노징 글라스</td><td data-p=\"SPKL\">와인 잔</td></tr><tr><th scope=\"row\">이럴 때</th><td data-p=\"초월 6.9\">일상의 저녁, 식사와</td><td data-p=\"DEEP Down\">식사와 함께, 더 자주</td><td data-p=\"DEEP\">천천히, 안주 없이도</td><td data-p=\"SPKL\">치즈 · 튀김 · 파스타와</td></tr></tbody></table>\n  </section>", "h": "2872ce5c3b94102b"}, "v2-product-69.html": {"t": "초월 6.9 — 초월", "d": "초월 6.9 6.9% · 가볍지 않은 가벼움", "c": "@P", "n": "v2-products.html", "b": "<section class=\"ph\">\n    <div class=\"ph-top\">\n      <div><span class=\"label rv\"><b>SIGNATURE</b> — 전통 삼양주 · 6.9% · 600 / 750ml</span><h1 class=\"rv\">초월 6.9</h1></div>\n      <div class=\"ph-side rv d2\"><p class=\"tag\">가볍지 않은 가벼움</p><p>편하게 즐길 수 있는 접근성과 깊이 있는 질감을 함께. 부드럽게 넘어가면서도 입안에 분명한 존재감을 남기는, 초월의 시그니처입니다.</p><div class=\"buy\"><div><span>600ml</span><span>9,600원</span></div><div><span>750ml</span><span>19,600원</span></div></div><div class=\"acts\"><a class=\"cta\" href=\"v2-brewery.html#visit\">양조장에서 구매</a><a class=\"cta line\" href=\"v2-stockists.html\">판매처 찾기</a></div></div>\n    </div>\n    <div class=\"ph-img mask rv\"><img class=\"px\" data-speed=\"-0.12\" src=\"v2img-c_hero.jpg\" alt=\"초월 6.9\" style=\"object-position:56% 50%\"></div>\n  </section>\n  <section class=\"state\">\n    <span class=\"label rv\"><b>초월 6.9</b></span>\n    <p class=\"big rv d1\">‘6.9’라는 이름은 도수 이상의 의미를 담고 있습니다. <em>부담스럽지 않으면서도 분명한 존재감을 남기는 균형. 가볍게 마실 수 있지만, 결코 가볍게 느껴지지 않는 구조입니다.</em></p>\n  </section>\n  <section class=\"sec\" style=\"padding-top:0\" aria-label=\"맛\">\n    <span class=\"label rv\" style=\"display:block;margin-bottom:24px\"><b>맛</b></span>\n    <div class=\"notes\"><div class=\"note rv\"><span class=\"label\">첫인상</span><b>부드러움</b><p>잔에 따르는 순간 느껴지는 질감. 전통 막걸리 특유의 거칠음보다는 정제된 느낌에 가깝습니다.</p></div><div class=\"note rv d1\"><span class=\"label\">바디감</span><b>가볍지 않은 가벼움</b><p>바디감을 지닌 채로 담백한, 과하지 않은 밀도와 부드러운 음용성.</p></div><div class=\"note rv d2\"><span class=\"label\">맛의 구조</span><b>균형</b><p>어느 하나가 튀지 않으면서 전체적인 조화를 이루는 방향. 마실수록 편안하고, 자연스럽게 다음 잔으로 이어집니다.</p></div></div>\n  </section>\n  <div class=\"split rev\">\n    <div class=\"mask rv\"><img class=\"px\" data-speed=\"-0.06\" src=\"v2img-c_p69.jpg\" alt=\"초월 6.9\" loading=\"lazy\"></div>\n    <div class=\"txt rv d1\"><span class=\"label\"><b>누구에게나</b></span><h3>“생각보다 너무<br>부드럽네요.”</h3><p>처음 드시는 분들께 가장 자주 듣는 말입니다. 전통주에 익숙하지 않은 분들도 편안하게 다가갈 수 있도록 설계했습니다.</p></div>\n  </div>\n  <section class=\"biglist\"><span class=\"label rv\"><b>즐기는 방법</b></span><ul><li class=\"rv\"><b>차갑게</b><span>냉장 상태 그대로, 전용잔에 천천히</span></li><li class=\"rv\"><b>온더락</b><span>얼음을 더하면 끝맛이 더 깔끔하게</span></li><li class=\"rv\"><b>탄산수 3 : 1</b><span>가볍고 산뜻한 하이볼처럼</span></li></ul></section>\n  <section class=\"sec alt\" aria-labelledby=\"dt\">\n    <div class=\"sec-head\"><div><span class=\"label rv\"><b>제품 정보</b></span><h2 id=\"dt\" class=\"rv\">초월 6.9</h2></div></div>\n    <dl class=\"facts rv\" style=\"margin:0\"><div><dt>식품 유형</dt><dd>탁주</dd></div><div><dt>알코올</dt><dd>6.9%</dd></div><div><dt>용량 · 가격</dt><dd>600ml 9,600원 · 750ml 19,600원</dd></div><div><dt>원재료</dt><dd>정제수, 쌀(해남산), 찹쌀(해남산), 누룩(국내산)</dd></div><div><dt>발효 · 숙성</dt><dd>48일, 전통 삼양주</dd></div><div><dt>소비기한</dt><dd>600ml 45일 · 750ml 70일</dd></div><div><dt>보관</dt><dd>냉장 보관 0–10℃</dd></div><div><dt>추천 잔</dt><dd>전용잔</dd></div></dl>\n  </section>\n\n  <section class=\"sec\" aria-labelledby=\"mo\">\n    <div class=\"sec-head\"><div><span class=\"label rv\"><b>더 보기</b></span><h2 id=\"mo\" class=\"rv\">다른 초월</h2></div><a class=\"link\" href=\"v2-products.html\">전체 라인업 <span aria-hidden=\"true\">→</span></a></div>\n    <div class=\"prods three\"><a class=\"prod rv\" href=\"v2-product-deep.html\"><div class=\"mask\"><img src=\"v2img-deep_p.jpg\" alt=\"DEEP\" loading=\"lazy\" style=\"object-position:50% 50%\"></div><div class=\"t\"><b>DEEP</b><span>18% · 375 / 750ml</span></div><p>56일 이상 완전 발효한 원주</p></a><a class=\"prod rv d1\" href=\"v2-product-deepdown.html\"><div class=\"mask\"><img src=\"v2img-down_p.jpg\" alt=\"DEEP Down\" loading=\"lazy\" style=\"object-position:50% 50%\"></div><div class=\"t\"><b>DEEP Down</b><span>12% · 375 / 750ml</span></div><p>DEEP 원주에 가수한 12도</p></a><a class=\"prod rv d2\" href=\"v2-product-spkl.html\"><div class=\"mask\"><img src=\"v2img-c_spkl.jpg\" alt=\"SPKL\" loading=\"lazy\" style=\"object-position:50% 60%\"></div><div class=\"t\"><b>SPKL</b><span>15.6% · 750ml</span></div><p>찹쌀과 타트체리, 천연 미탄산</p></a></div>\n  </section>", "h": "81186f7a0da969d8"}, "v2-product-deep.html": {"t": "DEEP — 초월", "d": "DEEP 18% · “이게 막걸리 맞나요?”", "c": "@P", "n": "v2-products.html", "b": "<section class=\"ph\">\n    <div class=\"ph-top\">\n      <div><span class=\"label rv\"><b>PREMIUM</b> — DEEP SERIES · 18% · 375 / 750ml</span><h1 class=\"rv\">DEEP</h1></div>\n      <div class=\"ph-side rv d2\"><p class=\"tag\">“이게 막걸리 맞나요?”</p><p>56일 이상 완전 발효가 끝난 뒤, 원주 중 윗술을 포함시켜 완성합니다. 그래서 소량으로만 생산되며, 일반적인 막걸리보다 훨씬 맑고 깊은 구조를 가지고 있습니다.</p><div class=\"buy\"><div><span>375ml</span><span>27,000원</span></div><div><span>750ml</span><span>52,000원</span></div></div><div class=\"acts\"><a class=\"cta\" href=\"v2-brewery.html#visit\">양조장에서 구매</a><a class=\"cta line\" href=\"v2-stockists.html\">판매처 찾기</a></div></div>\n    </div>\n    <div class=\"ph-img mask rv\"><img class=\"px\" data-speed=\"-0.12\" src=\"v2img-deep_duo.jpg\" alt=\"DEEP\" style=\"object-position:50% 50%\"></div>\n  </section>\n  <section class=\"state\">\n    <span class=\"label rv\"><b>DEEP</b></span>\n    <p class=\"big rv d1\">도수 18%, 하지만 강한 술이라는 느낌보다 <em>풍미의 구조가 먼저 느껴집니다.</em></p>\n  </section>\n  <section class=\"sec\" style=\"padding-top:0\" aria-label=\"테이스팅 노트\">\n    <span class=\"label rv\" style=\"display:block;margin-bottom:24px\"><b>테이스팅 노트</b></span>\n    <div class=\"notes\"><div class=\"note rv\"><span class=\"label\">NOSE</span><b>핵과실류의 과육 향</b><p>곡물만 썼지만 잔에 따르는 순간 올라오는 향</p></div><div class=\"note rv d1\"><span class=\"label\">PALATE</span><b>과하지 않은 단맛, 이어지는 드라이</b><p>달지 않게, 담백하게 이어지는 흐름</p></div><div class=\"note rv d2\"><span class=\"label\">FINISH</span><b>산뜻한 산미, 은은한 스파이시</b><p>위스키나 증류식 소주를 닮은 여운</p></div></div>\n  </section>\n  <div class=\"split rev\">\n    <div class=\"mask rv\"><img class=\"px\" data-speed=\"-0.06\" src=\"v2img-deep_p.jpg\" alt=\"DEEP\" loading=\"lazy\"></div>\n    <div class=\"txt rv d1\"><span class=\"label\"><b>TEXTURE</b></span><h3>천천히<br>경험하는 술</h3><p>6.9보다 바디는 가볍게, 대신 차분하게 밀도 있는 구조. 거칠지 않고, 부드럽지만 얇지 않습니다. 천천히 마실수록 향과 질감이 조금씩 열립니다.</p></div>\n  </div>\n  <section class=\"biglist\"><span class=\"label rv\"><b>즐기는 방법</b></span><ul><li class=\"rv\"><b>노징 글라스</b><span>향을 먼저</span></li><li class=\"rv\"><b>온더락</b><span>천천히</span></li><li class=\"rv\"><b>탄산수 3 : 1</b><span>가볍게</span></li><li class=\"rv\"><b>안주 없이도</b><span>충분합니다</span></li></ul></section>\n  <section class=\"sec alt\" aria-labelledby=\"dt\">\n    <div class=\"sec-head\"><div><span class=\"label rv\"><b>제품 정보</b></span><h2 id=\"dt\" class=\"rv\">DEEP</h2></div></div>\n    <dl class=\"facts rv\" style=\"margin:0\"><div><dt>알코올</dt><dd>18%</dd></div><div><dt>용량 · 가격</dt><dd>375ml 27,000원 · 750ml 52,000원</dd></div><div><dt>원료</dt><dd>쌀 · 찹쌀 · 누룩</dd></div><div><dt>발효</dt><dd>56일 이상 완전 발효 · 윗술 포함</dd></div><div><dt>추천 잔</dt><dd>노징 글라스</dd></div><div><dt>보관</dt><dd>냉장 보관 0–10℃</dd></div></dl>\n  </section>\n  <div style=\"padding-top:clamp(100px,14vh,160p